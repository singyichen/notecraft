---
// 講義頁籤（issue #3）：從 /references 點開的講義在工作台主區顯示，並成為一個上方頁籤。
// 筆記內的講義引用不經過這頁，仍開右側抽屜（ReferenceViewerDrawer）。
//
// 一份講義一頁，路徑是講義的完整相對路徑（含副檔名）：`_references/a/b.pdf` → `/references/doc/_references/a/b.pdf`。
// dev-only 的「我的產出」（_outputs/）與「實驗數據」（simulations/）只在 dev 產生路由 ——
// 正式 build 的 getStaticPaths 不列它們，dist 裡就沒有這些頁，也不會出現它們的路徑。
import WorkbenchLayout from "@/layouts/WorkbenchLayout.astro";
import ReferenceDocView from "@/components/islands/ReferenceDocView.tsx";
import { listReferenceDocs } from "@/lib/references";
import { getWorkbenchIndex } from "@/lib/workbench";

export async function getStaticPaths() {
  const docs = await listReferenceDocs({ includeLocal: import.meta.env.DEV });
  return docs.map((doc) => ({ params: { path: doc.relPath }, props: { doc } }));
}

const { doc } = Astro.props;
const index = await getWorkbenchIndex();
---

<WorkbenchLayout
  title={doc.name}
  description={`原始講義：${doc.relPath}`}
  rail="references"
  back="/references"
  bareBody
  tab={{ kind: "ref", id: doc.relPath, title: doc.name, path: doc.relPath, pending: 0 }}
  crumbs={[{ label: "NoteCraft", href: "/" }, { label: "原始講義", href: "/references" }, { label: doc.name }]}
>
  <ReferenceDocView client:load id={doc.relPath} name={doc.name} url={doc.url} workspace={index.workspaceLabel} />
</WorkbenchLayout>

<style is:global>
  /* 工具列：控制項在左（窄螢幕時一定看得到），路徑在右、放不下就截斷；完整路徑在 title */
  .nc-refdoc-tb {
    gap: 8px;
  }
  .nc-refdoc-path {
    min-width: 0;
    flex: 1 1 auto;
    justify-content: flex-end;
    gap: 8px;
  }
  .nc-refdoc-rel {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 11.5px;
    color: var(--wb-ink-3);
  }
  .nc-refdoc-content {
    min-height: 100%;
    padding: 16px;
    background: var(--wb-bg);
  }
  @media (max-width: 860px) {
    .nc-refdoc-rel {
      display: none;
    }
  }
</style>
